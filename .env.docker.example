# PostgreSQL Configuration
POSTGRES_USER=sunpower
POSTGRES_PASSWORD=sunpower_secure_password
POSTGRES_DB=sunpower_db

# Auto Seed Database with Demo Dataset on container startup
AUTO_SEED=true

# Security Key for Dashboard Sharing and JWTs
SECRET_KEY=sunpower-super-secret-key-production-ready

# Port configuration
FRONTEND_PORT=5173
BACKEND_PORT=8000
