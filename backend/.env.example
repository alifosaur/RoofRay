PROJECT_NAME="SunPower Solutions"
ENV="development"
DEBUG=True
API_V1_PREFIX="/api"

# Database: SQLite fallback by default for local quick demo; PostgreSQL supported
DATABASE_URL="sqlite:///./sunpower.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/sunpower"

# Firebase Admin
FIREBASE_CREDENTIALS_PATH="firebase-service-account.json"
# When set to True, allows local dev auth tokens when firebase credentials are absent
DEV_AUTH_BYPASS=True

# Uploads directory
UPLOAD_DIR="./uploads"

# JWT Secret for dashboard share links
SECRET_KEY="sunpower-secret-key-change-in-production"
